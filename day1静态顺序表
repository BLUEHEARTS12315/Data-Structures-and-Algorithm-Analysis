#此为静态顺序表的演示与练习
#include <cstring>
#include <iostream>
using namespace std;
/*
 * 5,6,7,23,234,11,765     插入的元素
 * 1,2,3, 4, 5, 6,  7, 8, 9         pos顺序位置
 * 0,1,2 ,3 ,4, 5, 6  ,7, 8                                 数组下标
 *
 */


#define MAX 100 //使用宏定义 MAX
typedef int jkl;
struct seqlist {
    jkl data[MAX]; //数组下标元素
    size_t length;  //长度

};
void clearseqlist(seqlist &seq) {
        memset(&seq,0,sizeof(seq));

}
bool insertlist(seqlist &seq,const size_t pos,const jkl &ee) {//pos 是顺序数
    if (seq.length==MAX) {//检查顺序表是否已满
           cout<<"顺序表已经满了不支持在放入\n";
        return false;//返回false
    }
    if (pos<1||pos>seq.length+1) {// 检查插入位置是否合法pos从1开始
        cout<<"插入位置不合适";
        return false;
    }
    //这个是如果不是在末尾插入，需要移动元素
    if (pos<seq.length+1) {
        //这里指的是将pos位置及其后的元素向后移动一个位置
        memmove(seq.data+pos,seq.data+pos-1,(seq.length-pos+1)*sizeof(jkl));

        memcpy(&seq.data[pos-1],&ee,sizeof(jkl));
        seq.length++;//表长加1
        return true;
    }


}
//获取顺序表长度
size_t lengthlist(seqlist &seq) {
    return seq.length;//直接返回长度成员
}

// 获取第pos个元素的值
bool getPos(const seqlist seq, const size_t pos,jkl &ee) {
    //检查位置是否合法
    if ((pos<1)||(pos>seq.length)) {
        return false;

    }
    ee=seq.data[pos-1];
    return true;
}
// 在表头插入元素
bool pushfront(seqlist &seq,jkl &ee) {
    return insertlist(seq,seq.length,ee);

}
// 在表尾插入元素
bool pushback(seqlist &seq,jkl &ee) {
    return insertlist(seq,seq.length+1,ee);

}
// 查找元素ee的位置
size_t findjkl(seqlist &seq,const jkl&ee) {
    // 遍历顺序表
    for (size_t i=0;i<seq.length;i++) {
        // 如果找到相等的元素，返回位置（下标+1）
        if (seq.data[i]==ee) {
            return i+1;
        }
        return 0;// 未找到返回0
    }

}
// 删除第pos个元素
bool Deletepos(seqlist &seq,const size_t pos) {
            if ((pos<1)||(pos>seq.length)) {
                cout << "删除位置" << pos << "不合法，应该在1-" << seq.length << "之间。\n";
                return false;
            }
    // 将pos之后的元素向前移动一个位置
    memmove(&seq.data[pos - 1], &seq.data[pos], sizeof(jkl) * (seq.length - pos));
               seq.length--;        // 表长减少1
    return true;


}
// 删除表头元素
bool PopFront(seqlist& seq)
{
   return Deletepos(seq,1); // 删除位置1的元素
}

// 删除表尾元素
bool PopBack(seqlist& seq )
{
    return Deletepos(seq, seq.length);  // 删除最后一个元素
}
// 判断顺序表是否为空
bool IsEmpty(const seqlist& seq)
{
    if (seq.length == 0)
        return true;
    return false;
}
// 打印顺序表所有元素
void PrintList(const seqlist& seq) {
    if (seq.length == 0) {
        cout << "表为空。\n";
        return;
    }
    // 遍历并打印所有元素
        for (size_t i=0;i<seq.length;i++) {
            cout << seq.data[i] << " ";

        }
    cout << endl;

}



